# LLM 제공자 설정
MODEL_PROVIDER=openrouter
MODEL_NAME=openai/gpt-4o-mini
MINI_MODEL_NAME=google/gemini-2.5-flash-lite

# API 키 (사용자가 채움)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI/Anthropic/Google 키는 openrouter 전환으로 불필요하나 하위 호환용으로 유지
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# PostgreSQL (compose 내부에서 postgres 서비스로 오버라이드됨)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=linkid_ai
POSTGRES_USER=linkid_user
POSTGRES_PASSWORD=linkid_password

# VectorDB 설정
VECTOR_DB_TABLE=expert_advice
EMBEDDING_MODEL=openrouter
EMBEDDING_MODEL_NAME=openai/text-embedding-3-small
EMBEDDING_DIMENSION=1536
VECTOR_SEARCH_TOP_K=5
VECTOR_SEARCH_THRESHOLD=0.7
USE_VECTOR_DB=true
USE_DPICS_ELECTRA=false

# Ollama (선택)
OLLAMA_BASE_URL=http://host.docker.internal:11434
